! Dry Held and Suarez (1994) benchmark: T42 with 20 evenly spaced sigma
! levels, flat topography, no radiation, moisture or surface fluxes.
! The forcing is set in held_suarez_nml; it depends only on latitude and
! sigma, so the resolution and levels below can be changed freely.
! The sphum tracer (field_table) is required but stays zero.

 &coupler_nml
    days     = 1200,
    dt_atmos = 1200 /

 &spectral_dynamics_nml
    lon_max           = 128,
    lat_max           = 64,
    num_fourier       = 42,
    num_spherical     = 43,
    num_levels        = 20,
    vert_coord_option = 'even_sigma',
    topography_option = 'flat',
    initial_sphum     = 0.,
    use_virtual_temperature = .false.,
    do_water_correction     = .false. /

 &radiation_nml
    radiation_scheme = 'none' /

 &physics_driver_nml
    do_held_suarez    = .true.,
    do_boundary_layer = .false.,
    do_moist_physics  = .false.,
    do_damping        = .false. /

 &flux_exchange_nml
    z_ref_heat = 2.0,
    z_ref_mom = 10.0 /
 &surface_albedo_nml
    albedo_profile = 'constant',
    const_albedo = 0.23,
    higher_albedo = 0.8,
    albedo_exp = 2.0,
    albedo_cntrNH = 68.0,
    albedo_cntrSH = 64.0,
    albedo_wdth = 5.0,
    step_lat_nh = 90.,
    step_lat_sh = -90.,
    albedo_desert = 0.2 /
 &ocean_model_nml
    ocean_model = 'slab',
    sst_init = 'profile',
    Tm = 285.0,
    deltaT = 40.0,
    rough_ocean = 3.21e-05,
    heat_capacity = 3.e08,
    trop_capacity = 1.e08,
    trop_cap_limit = 20.0,
    heat_cap_limit = 60.0,
    np_cap_factor = 1.0 /
 ! the surface is not coupled; this only avoids reading land-mask files
 &land_model_nml
    land_model = 'simple',
    land_mask = 'none',
    land_mask_file = 'lmask',
    land_height_limit = 10.0,
    heat_capacity = 1.e07,
    t_init = 'ocean',
    rough_mom_factor = 1.,
    rough_moist_factor = 1.,
    rough_moist_profile = 'uniform',
    hydrology = 'saturated',
    do_snow = .false. /
 &qflux_nml
    qflux_source = 'none',
    do_warmpool = .false. /


 &held_suarez_nml
    ! HS94 values (the defaults), listed for reference
    t_zero  = 315.,
    t_strat = 200.,
    delh    = 60.,
    delv    = 10.,
    sigma_b = 0.7,
    ka      = 40.,
    ks      = 4.,
    kf      = 1. /

 &fms_nml
    domains_stack_size = 600000 /

 &sat_vapor_pres_nml
    do_simple = .true. /
